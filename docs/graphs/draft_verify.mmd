---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	draft(draft)
	verify(verify)
	revise(revise)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> draft;
	draft --> verify;
	revise --> verify;
	verify -.-> finish;
	verify -.-> revise;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
