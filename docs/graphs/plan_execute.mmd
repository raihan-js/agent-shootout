---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	planner(planner)
	executor(executor)
	synth(synth)
	__end__([<p>__end__</p>]):::last
	__start__ --> planner;
	executor -.-> synth;
	planner -.-> __end__;
	planner -.-> executor;
	synth --> __end__;
	executor -.-> executor;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
